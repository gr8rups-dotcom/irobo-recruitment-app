# Local dev default (SQLite file). For deployment on Vercel, switch to a hosted
# Postgres database (Vercel's serverless filesystem is not writable/persistent) —
# see README "Going to production" section.
DATABASE_URL="file:./dev.db"

# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY="sk-ant-..."

# Optional — defaults to a fast/cheap model if unset
ANTHROPIC_MODEL="claude-haiku-4-5-20251001"
