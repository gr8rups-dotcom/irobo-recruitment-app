# Multi-user app — requires a real Postgres database, both locally and in
# production (Vercel's serverless filesystem can't host SQLite). A free Neon
# (https://neon.tech) or Supabase (https://supabase.com) project works.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Session signing secret for NextAuth. Generate your own — never reuse this
# example or a value you've pasted anywhere else:
#   openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET="generate-your-own-32-byte-random-string"

# Server-only secret used to encrypt each user's own Anthropic API key at
# rest (see "Bring your own key" in README). Generate your own per
# environment — local and production must NOT share the same value:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY="generate-your-own-32-byte-base64-key"

# Optional — which model every user's own key calls. Not itself a secret.
ANTHROPIC_MODEL="claude-haiku-4-5-20251001"

# LinkedIn sign-in is optional. Leave blank to only offer email+password.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
NEXT_PUBLIC_LINKEDIN_ENABLED=false
